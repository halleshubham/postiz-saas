# SaaS database (PostgreSQL)
DATABASE_URL=postgresql://postiz_saas:password@db:5432/postiz_saas

# Postiz self-hosted database
POSTIZ_DATABASE_URL=postgresql://postiz-user:password@host:5434/postiz-db-local

# Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-char-random-string
ADMIN_EMAILS=admin@shackyapps.in

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-app-password

# Stripe
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_HOBBY_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_yyy

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTIZ_INSTANCE_URL=https://app.shackyapps.in

# Cron secret (for /api/cron/daily-stats)
CRON_SECRET=replace-with-random-secret

# Docker compose only
DB_PASSWORD=changeme
