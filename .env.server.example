# Local database you asked to keep in context.
DATABASE_URL=postgresql://postiz_saas:postiz_saas@localhost:5432/postiz_saas

# Your existing self-hosted Postiz public API base URL.
POSTIZ_BASE_URL=https://app.shackyapps.in/public/v1

# Optional fallback platform API key. Companies can also save their own token in Settings.
POSTIZ_ADMIN_API_KEY=

# 32+ chars. Replace before production.
TOKEN_ENCRYPTION_KEY=development-token-encryption-key-change-me

# Comma-separated app admins.
ADMIN_EMAILS=admin@shackyapps.in
SENDGRID_API_KEY=replace-with-sendgrid-api-key

# Stripe test values. Replace when turning payments on.
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYMENTS_HOBBY_SUBSCRIPTION_PLAN_ID=starter-dev-price
PAYMENTS_PRO_SUBSCRIPTION_PLAN_ID=growth-dev-price
PAYMENTS_CREDITS_10_PLAN_ID=credits-disabled
